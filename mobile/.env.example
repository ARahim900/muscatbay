# ---------------------------------------------------------------------------
# Muscat Bay Operations — mobile environment
#
#   cp .env.example .env
#
# Both values are the SAME Supabase project the web app uses. Copy them from
# either of these places (they are identical, only the prefix changes):
#
#   • muscatbay/app/.env.local            NEXT_PUBLIC_SUPABASE_URL
#                                         NEXT_PUBLIC_SUPABASE_ANON_KEY
#   • Vercel → muscatbay project → Settings → Environment Variables
#   • Supabase dashboard → Project Settings → API → Project URL / anon public key
#
# Expo only inlines variables prefixed EXPO_PUBLIC_, hence the rename.
# The anon key is a public, RLS-scoped key — the same one the website ships to
# every browser. Never put the service-role key here.
#
# `.env` is git-ignored. Restart `npx expo start` after changing it: these are
# compile-time inlined, not read at runtime.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional. Only needed once you move off Expo Go to a development build and
# want push notifications. `eas init` writes it for you.
# EAS_PROJECT_ID=
