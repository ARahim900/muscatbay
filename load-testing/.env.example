# Muscat Bay load testing — environment template
#
# Copy to load-testing/.env and fill in. The .env file is gitignored — NEVER
# commit real values, and never paste tokens into scripts, YAML or CI logs.
# Load it into a shell before running k6/Artillery:   set -a; . ./.env; set +a

# ── Target (REQUIRED — the scripts refuse to run without it) ─────────────────
# The app origin under test. Prefer a Vercel PREVIEW deployment or localhost;
# only point at https://muscatbay.work deliberately (see README §Safe testing).
BASE_URL=

# ── Data tier (optional — omit both to load-test page shells only) ───────────
# Same values the app itself uses (muscatbay/app/.env.local). The anon key is
# a publishable client key, but keep it out of git all the same.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# ── Authentication for simulated users ───────────────────────────────────────
# Dedicated least-privilege LOAD-TEST account (create it in Supabase Auth).
# Never a real operator's credentials. Used only by `npm run -s token`.
LOADTEST_EMAIL=
LOADTEST_PASSWORD=

# Bearer token for the REST tier — DO NOT paste one here. Mint it fresh into
# the shell right before a run (tokens expire in ~1 hour):
#   export AUTH_TOKEN="$(npm run -s token)"

# Optional Cookie alternative for the page tier: the sb-<project-ref>-auth-token
# cookie chunks copied from a signed-in browser session (DevTools → Application
# → Cookies). Same handling rules as a password. Usually unnecessary — page
# shells render for anonymous requests (route protection is client-side).
# SESSION_COOKIE=

# ── Thresholds / pacing overrides (defaults shown; k6 only) ──────────────────
# P50_MS=500
# P95_MS=1500
# MAX_ERROR_RATE=0.01
# THINK_MIN_S=2
# THINK_MAX_S=6
