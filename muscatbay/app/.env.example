# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Find your values at: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (set to your production domain for auth redirects)
# If not set, falls back to window.location.origin
# NEXT_PUBLIC_SITE_URL=https://your-app-domain.com

# Development Mode (ONLY for local development - NEVER enable in production)
# This bypasses authentication for testing purposes
# NEXT_PUBLIC_DEV_MODE=true


# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS
#
# These are read by server code only (route handlers, proxy.ts, scripts).
# NEVER prefix any of them with NEXT_PUBLIC_ — that would inline the value into
# the client bundle and publish it to every visitor. On Vercel, set them as
# sensitive variables; do not commit real values here.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase service_role key. Bypasses RLS entirely, so it is confined to:
#   - app/api/alerts/reconcile/route.ts  (nightly incident reconciler)
#   - app/api/admin/invitations/route.ts (issuing dashboard invitations)
#   - scripts/*                          (one-off data loads, run locally)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret for the Vercel cron that calls /api/alerts/reconcile.
# The route rejects any request whose Authorization header is not
# "Bearer <CRON_SECRET>", so the reconciler cannot be triggered by outsiders.
# Generate a fresh random value: openssl rand -base64 32
# CRON_SECRET=your-cron-secret-here

# Content-Security-Policy enforcement switch (proxy.ts).
# Unset — the default — sends the ENFORCING Content-Security-Policy header.
# Set to 'true' only to debug a policy: it downgrades to
# Content-Security-Policy-Report-Only, which reports violations but blocks
# nothing. Never set this in production.
# CSP_REPORT_ONLY=true
