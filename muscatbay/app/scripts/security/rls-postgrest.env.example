# Disposable staging only. The script rejects the production project ref.
RLS_TEST_CONFIRM_STAGING=YES
RLS_TEST_SUPABASE_URL=https://your-staging-project.supabase.co
RLS_TEST_EXPECTED_PROJECT_REF=your-staging-project
RLS_TEST_ANON_KEY=

RLS_TEST_VIEWER_EMAIL=
RLS_TEST_VIEWER_PASSWORD=
RLS_TEST_CONTRACTOR_EMAIL=
RLS_TEST_CONTRACTOR_PASSWORD=
RLS_TEST_ADMIN_EMAIL=
RLS_TEST_ADMIN_PASSWORD=

# Choose an operational table with a generated primary key. The template must
# contain every required insert field. {{RUN_ID}} is replaced for each fixture.
# Assign the Contractor profile's module_scope to the chosen table's module so
# the script can verify allowed SELECT while still denying every write verb.
RLS_TEST_TABLE=
RLS_TEST_ID_COLUMN=id
RLS_TEST_MUTABLE_COLUMN=
RLS_TEST_INSERT_TEMPLATE_JSON={"required_text_field":"{{RUN_ID}}"}
